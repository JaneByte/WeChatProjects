<view class='page'>
  <view class='state' wx:if='{{loading}}'>正在根据你的场景搭配商品，请稍等</view>
  <view class='state' wx:elif='{{!combo}}'>这次还没配出合适方案，换个条件再试试</view>

  <view wx:else>
    <view class='hero'>
      <view class='title'>{{combo.comboName}}</view>
      <view class='sub'>按场景帮你配齐</view>
      <view class='hero-price'>预计总价 <text class='hero-price__value'>¥{{combo.priceSummary.totalPrice}}</text></view>
      <view class='price-card'>
        <view class='price-row'>
          <text class='price-label'>单买小计</text>
          <text class='price-value price-value--line'>¥{{combo.priceSummary.originalTotalPrice}}</text>
        </view>
        <view class='price-row'>
          <text class='price-label'>套餐优惠</text>
          <text class='price-value price-value--discount'>-¥{{combo.priceSummary.packDiscount}}</text>
        </view>
        <view class='price-hint' wx:if='{{combo.priceSummary.couponHint}}'>{{combo.priceSummary.couponHint}}</view>
      </view>
      <view class='summary-card'>
        <view class='summary-title'>{{comboSummaryTitle}}</view>
        <view class='summary-text'>{{comboSummaryText}}</view>
      </view>
      <view class='hero-note' wx:for='{{combo.warnings || []}}' wx:key='index'>{{item}}</view>
    </view>

    <view class='card'>
      <view class='card-title'>这组搭配包含</view>
      <view class='item' wx:for='{{combo.items}}' wx:key='_itemKey'>
        <view class='item-head'>
          <view class='item-name-row'>
            <view class='item-name'>{{item.name}}</view>
            <view class='item-unit-price'>{{item.priceText}}</view>
          </view>
          <view class='replace-btn' data-index='{{index}}' bindtap='onReplaceItem'>换一项</view>
        </view>
        <view class='item-meta'>{{item.roleText || '组合项'}} · {{item.skuName || '默认规格'}} · x{{item.quantity}}</view>
        <view class='item-meta item-tagline' wx:if='{{item._reasonTagShort}}'>
          {{item._reasonTagShort}}<text wx:if='{{item._reasonTagMore > 0}}'> +{{item._reasonTagMore}}</text>
        </view>
        <view class='item-reason' wx:if='{{item._reasonShort}}'>{{item._reasonShort}}</view>
      </view>
    </view>

    <view class='card' wx:if='{{combo.prepHint}}'>
      <view class='card-title'>推荐说明</view>
      <view class='meta-line'>{{combo.prepHint}}</view>
    </view>

    <view class='action-row'>
      <button class='ghost-btn' bindtap='onRegenerate'>换一组搭配</button>
      <button class='primary-btn' loading='{{submitting}}' disabled='{{submitting}}' bindtap='onBuyNow'>立即购买</button>
    </view>
  </view>
</view>
