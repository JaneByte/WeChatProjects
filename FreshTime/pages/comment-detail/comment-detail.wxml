<view class='page'>
  <view wx:if='{{loading}}' class='state'>加载中...</view>
  <view wx:elif='{{!detail}}' class='state'>评价不存在</view>
  <view wx:else class='card'>
    <view class='title-row'>
      <text class='title'>评分：{{detail.rating || 0}}</text>
      <text class='time'>{{detail.createTime || ''}}</text>
    </view>
    <view class='content'>{{detail.content || '用户未填写评价内容'}}</view>
    <view class='meta'>订单ID：{{detail.orderId}}</view>
    <view class='meta'>商品ID：{{detail.goodsId}}</view>
    <button class='back-btn' bindtap='onBackOrder'>返回订单详情</button>
  </view>
</view>
