<view class='page'>
  <view wx:if='{{loading}}' class='state'>加载中...</view>
  <view wx:elif='{{!detail}}' class='state'>商品不存在</view>

  <view wx:else>
    <image class='cover' src='{{detail.mainImage}}' mode='aspectFit'></image>
    <view class='card'>
      <view class='price-row-main'>
        <view class='title-wrap'>
          <view class='title'>{{detail.name}}</view>
          <view class='goods-price-wrap'>
            <view class='goods-price-current'>¥{{displayPriceText}}</view>
            <view class='goods-price-original' wx:if='{{showOriginalPrice}}'>原价 {{originalPriceText}}</view>
          </view>
        </view>
        <view class='sales-pill'>销量 {{detail.salesVolume || 0}}</view>
      </view>
      <view class='seasonal-panel' wx:if='{{sourceType === "SEASONAL"}}'>
        <view class='seasonal-badge-row'>
          <text class='seasonal-badge'>{{seasonalBadgeText || '当季精选'}}</text>
          <text class='seasonal-badge warn' wx:if='{{seasonalUrgencyText}}'>临近过季</text>
        </view>
        <view class='meta'>{{seasonalContextText}}</view>
        <view class='meta' wx:if='{{seasonalWindowText}}'>{{seasonalWindowText}}</view>
        <view class='meta' wx:if='{{seasonalTipText}}'>{{seasonalTipText}}</view>
      </view>
      <view class='flash-panel' wx:if='{{sourceType === "FLASH"}}'>
        <view class='flash-panel-row'>
          <text class='flash-panel-badge'>秒杀进行中</text>
          <text class='flash-panel-remain' wx:if='{{flashRemainText}}'>{{flashRemainText}}</text>
        </view>
        <view class='flash-panel-spec'>秒杀规格：{{flashSpecLabelText}}</view>
        <view class='flash-panel-progress'>
          <view class='flash-panel-track'>
            <view class='flash-panel-inner' style='width: {{flashDisplayPercent}}%;'></view>
          </view>
          <text class='flash-panel-text'>已抢 {{flashDisplayPercent}}%</text>
        </view>
      </view>
      <view class='detail-block' wx:if='{{detail.detail}}'>
        <view class='section-caption'>商品详情</view>
        <view class='detail-text'>{{detail.detail}}</view>
      </view>
      <view class='meta' wx:if='{{selectedSku ? ((selectedSku.skuStock || 0) <= 0) : (detail.stock <= 0)}}'>当前规格暂时售空，可看看其他规格</view>
      <view class='meta' wx:if='{{sourceType === "FLASH"}}'>秒杀价仅适用于 {{flashSpecLabelText}}，默认按该规格下单</view>
      <view class='spec-select-wrap' wx:if='{{detail.skuList && detail.skuList.length > 0}}'>
        <view class='section-caption'>规格选择</view>
        <picker wx:if='{{sourceType !== "FLASH"}}' mode='selector' range='{{detail.skuList}}' range-key='skuName' value='{{selectedSkuIndex || 0}}' bindchange='onPickerSkuChange'>
          <view class='spec-picker'>
            <view class='spec-picker-value'>
              规格：{{selectedSku ? (selectedSku.skuName || '标准装') : '请选择规格'}}{{selectedSku && selectedSku.skuWeightG ? (' · ' + selectedSku.skuWeightG + 'g') : ''}}
            </view>
            <text class='spec-picker-arrow'>▼</text>
          </view>
        </picker>
        <view wx:else class='spec-picker spec-picker--readonly'>
          <view class='spec-picker-value'>规格：{{flashSpecLabelText}}</view>
        </view>
        <view class='spec-hint' wx:if='{{selectedSku}}'>
          <text>当前可售：{{selectedSku.skuStock || 0}} {{detail.unit || '件'}}</text>
        </view>
      </view>
    </view>

    <view class='actions'>
      <view class='qty-wrap'>
        <view class='qty-btn' bindtap='onMinus'>-</view>
        <input class='qty' type='number' value='{{quantity}}' bindinput='onInputQuantity' />
        <view class='qty-btn' bindtap='onPlus'>+</view>
      </view>
      <button class='btn ghost' bindtap='onAddCart' disabled='{{selectedSku ? ((selectedSku.skuStock || 0) <= 0) : (detail.stock <= 0)}}'>加入</button>
      <button class='btn primary' bindtap='onBuyNow' disabled='{{selectedSku ? ((selectedSku.skuStock || 0) <= 0) : (detail.stock <= 0)}}'>立即下单</button>
    </view>
    <view class='card'>
      <view class='comment-head'>
        <text class='comment-title'>商品评价</text>
        <text class='comment-score' wx:if='{{commentSummary}}'>{{commentSummary.avgRating || 0}}分（{{commentSummary.totalCount || 0}}条）</text>
      </view>
      <view wx:if='{{commentList.length === 0}}' class='comment-empty'>暂时还没有评价，欢迎成为第一位分享体验的人</view>
      <view wx:for='{{commentList}}' wx:key='id' class='comment-item'>
        <view class='comment-item-top'>
          <text class='comment-rating'>评分：{{item.rating || 0}}</text>
          <text class='comment-time'>{{item.createTime || ''}}</text>
        </view>
        <view class='comment-content'>{{item.content || '用户未填写评价内容'}}</view>
      </view>
      <view class='comment-more' wx:if='{{commentHasMore}}' bindtap='onLoadMoreComments'>加载更多</view>
    </view>
  </view>
</view>
