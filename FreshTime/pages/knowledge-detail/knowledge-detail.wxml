<view class='page'>
  <view wx:if='{{loading}}' class='state'>加载中...</view>
  <view wx:elif='{{loadError}}' class='state'>
    <text>加载失败，请重试</text>
    <button size='mini' bindtap='onRetry'>重试</button>
  </view>
  <view wx:elif='{{!article}}' class='state'>暂无科普内容</view>

  <view wx:else class='card'>
    <view class='title'>{{article.title}}</view>
    <view class='sub-title'>{{article.summary}}</view>

    <view class='tag-row' wx:if='{{article.tags.length}}'>
      <text class='tag' wx:for='{{article.tags}}' wx:key='*this'>{{item}}</text>
    </view>

    <view class='section' wx:if='{{article.pickGuide.length}}'>
      <view class='section-title'>选购指南</view>
      <view class='bullet' wx:for='{{article.pickGuide}}' wx:key='index'>{{index + 1}}. {{item}}</view>
    </view>

    <view class='section' wx:if='{{article.nutrition.length}}'>
      <view class='section-title'>营养重点</view>
      <view class='bullet' wx:for='{{article.nutrition}}' wx:key='index'>{{index + 1}}. {{item}}</view>
    </view>

    <view class='section' wx:if='{{article.pairing.length}}'>
      <view class='section-title'>搭配建议</view>
      <view class='bullet' wx:for='{{article.pairing}}' wx:key='index'>{{index + 1}}. {{item}}</view>
    </view>

    <view class='section' wx:if='{{article.cautions.length}}'>
      <view class='section-title'>食用提醒</view>
      <view class='bullet' wx:for='{{article.cautions}}' wx:key='index'>{{index + 1}}. {{item}}</view>
    </view>

    <view class='section' wx:if='{{article.content}}'>
      <view class='section-title'>详细说明</view>
      <view class='paragraph'>{{article.content}}</view>
    </view>

    <view class='action' bindtap='onTapSearch'>查看相关食材</view>

    <view class='section' wx:if='{{recommendGoods.length}}'>
      <view class='section-title'>相关推荐</view>
      <view class='goods-grid'>
        <view class='goods-item' wx:for='{{recommendGoods}}' wx:key='id'>
          <image class='goods-image' src='{{item.image}}' mode='aspectFill' bindtap='onTapRecommend' data-id='{{item.id}}'></image>
          <view class='goods-name'>{{item.name}}</view>
          <view class='goods-foot'>
            <text class='goods-price'>¥{{item.price}}</text>
            <view class='goods-add' bindtap='onAddRecommend' data-id='{{item.id}}'>+</view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
