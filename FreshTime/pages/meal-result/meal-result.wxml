<view class='page'>
  <view class='state' wx:if='{{loading}}'>正在帮你搭配更合适的小份优选，请稍等</view>
  <view class='state' wx:elif='{{!plan}}'>这次还没配出合适方案，换个条件再试试</view>

  <view wx:else>
    <view class='hero'>
      <view class='title'>{{plan.planName}}</view>
      <view class='sub'>{{plan.serving}} 人份参考</view>
      <view class='hero-price'>预计总价 <text class='hero-price__value'>¥{{plan.priceSummary.totalPrice}}</text></view>
      <view class='price-card'>
        <view class='price-row'>
          <text class='price-label'>单买小计</text>
          <text class='price-value price-value--line'>¥{{plan.priceSummary.originalTotalPrice}}</text>
        </view>
        <view class='price-row'>
          <text class='price-label'>套餐优惠</text>
          <text class='price-value price-value--discount'>-¥{{plan.priceSummary.packDiscount}}</text>
        </view>
        <view class='price-hint' wx:if='{{plan.priceSummary.couponHint}}'>{{plan.priceSummary.couponHint}}</view>
      </view>
      <view class='summary-card'>
        <view class='summary-title'>{{planSummaryTitle}}</view>
        <view class='summary-text'>{{planSummaryText}}</view>
      </view>
      <view class='hero-note' wx:for='{{plan.warnings || []}}' wx:key='index'>{{item}}</view>
    </view>

    <view class='card'>
      <view class='card-title'>这份搭配包含</view>
      <view class='item' wx:for='{{plan.items}}' wx:key='_itemKey'>
        <view class='item-head'>
          <view class='item-name-row'>
            <view class='item-name'>{{item.name}}</view>
            <view class='item-unit-price'>{{item.priceText}}</view>
          </view>
          <view class='replace-btn' data-index='{{index}}' bindtap='onReplaceItem'>换一项</view>
        </view>
        <view class='item-meta'>{{item.roleText}} · {{item.skuName || '默认规格'}} · x{{item.quantity}} {{item.gramsEstimate ? ('· 约' + item.gramsEstimate + 'g') : ''}}</view>
        <view class='item-meta item-tagline' wx:if='{{item._reasonTagShort}}'>
          {{item._reasonTagShort}}<text wx:if='{{item._reasonTagMore > 0}}'> +{{item._reasonTagMore}}</text>
        </view>
        <view class='item-reason' wx:if='{{item._reasonShort}}'>{{item._reasonShort}}</view>
      </view>
    </view>

    <view class='card'>
      <view class='card-title'>推荐说明</view>
      <view class='reason-highlight' wx:if='{{plan.wasteEstimate.reason}}'>{{plan.wasteEstimate.reason}}</view>
    </view>

    <view class='action-row'>
      <button class='ghost-btn' bindtap='onRegenerate'>换一份方案</button>
      <button class='primary-btn' loading='{{submitting}}' disabled='{{submitting}}' bindtap='onBuyNow'>立即购买</button>
    </view>
  </view>
</view>
