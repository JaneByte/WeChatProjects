<view class='page'>
  <view class='state' wx:if='{{loading}}'>正在生成方案...</view>
  <view class='state' wx:elif='{{!plan}}'>暂无方案，请返回重试</view>

  <view wx:else>
    <view class='hero'>
      <view class='title'>{{plan.planName}}</view>
      <view class='sub'>适用 {{plan.serving}} 人 · 预计总价 ¥{{plan.priceSummary.totalPrice}}</view>
      <view class='summary-card'>
        <view class='summary-title'>{{planSummaryTitle}}</view>
        <view class='summary-text'>{{planSummaryText}}</view>
      </view>
      <view class='tip' wx:if='{{plan.priceSummary.originalTotalPrice > plan.priceSummary.totalPrice}}'>单买约 ¥{{plan.priceSummary.originalTotalPrice}} · 当前已省 ¥{{plan.priceSummary.savedAmount}}</view>
      <view class='tip' wx:if='{{plan.priceSummary.originalTotalPrice <= plan.priceSummary.totalPrice}}'>当前按小份优先与场景适配推荐组合，适合直接加购</view>
      <view class='tip' wx:if='{{plan.priceSummary.couponHint}}'>{{plan.priceSummary.couponHint}}</view>
      <view class='tip' wx:if='{{replaceDeltaText}}'>{{replaceDeltaText}}</view>
      <view class='tip' wx:for='{{plan.warnings || []}}' wx:key='index'>{{item}}</view>
    </view>

    <view class='card'>
      <view class='card-title'>方案明细</view>
      <view class='item' wx:for='{{plan.items}}' wx:key='_itemKey'>
        <view class='item-head'>
          <view class='item-name'>{{item.name}}</view>
          <view class='replace-btn' data-index='{{index}}' bindtap='onReplaceItem'>换一项</view>
        </view>
        <view class='item-meta'>{{item.role}} · {{item.skuName || '默认规格'}} · x{{item.quantity}} {{item.gramsEstimate ? ('· 约' + item.gramsEstimate + 'g') : ''}}</view>
        <view class='item-meta item-tagline' wx:if='{{item._reasonTagShort}}'>
          {{item._reasonTagShort}}<text wx:if='{{item._reasonTagMore > 0}}'> +{{item._reasonTagMore}}</text>
        </view>
        <view class='reason-row' wx:if='{{item._reasonLong}}'>
          <view class='item-reason'>{{reasonExpandedMap[item._itemKey] ? item._reasonLong : item._reasonShort}}</view>
          <view class='reason-toggle' data-item-key='{{item._itemKey}}' bindtap='onToggleReason'>
            {{reasonExpandedMap[item._itemKey] ? '收起说明' : '查看说明'}}
          </view>
        </view>
      </view>
    </view>

    <view class='card'>
      <view class='card-title'>营养与浪费预估</view>
      <view class='meta-line'>单买参考：¥{{plan.priceSummary.originalTotalPrice || plan.priceSummary.totalPrice}} / 组合价：¥{{plan.priceSummary.packagePrice || plan.priceSummary.totalPrice}}</view>
      <view class='meta-line'>热量：{{plan.nutritionSummary.caloriesRange || '暂无'}}</view>
      <view class='meta-line'>纤维：{{plan.nutritionSummary.fiberLevel || '暂无'}}</view>
      <view class='meta-line'>维C：{{plan.nutritionSummary.vitaminCLevel || '暂无'}}</view>
      <view class='meta-line'>浪费等级：{{plan.wasteEstimate.level || '暂无'}} {{plan.wasteEstimate.reason ? ('· ' + plan.wasteEstimate.reason) : ''}}</view>
    </view>

    <view class='card' wx:if='{{plan.strategySummary}}'>
      <view class='card-title'>本次策略说明</view>
      <view class='meta-line'>策略版本：{{plan.strategySummary.weightProfile}}</view>
      <view class='meta-line'>权重：小份{{plan.strategySummary.smallPortionWeight}} / 销量{{plan.strategySummary.salesWeight}} / 库存{{plan.strategySummary.stockWeight}} / 预算{{plan.strategySummary.budgetWeight}}</view>
      <view class='meta-line'>兜底：{{plan.strategySummary.fallbackUsed ? '已触发' : '未触发'}}{{plan.strategySummary.fallbackReason ? (' · ' + plan.strategySummary.fallbackReason) : ''}}</view>
    </view>

    <view class='action-row'>
      <button class='ghost-btn' bindtap='onRegenerate'>重新生成</button>
      <button class='primary-btn' loading='{{submitting}}' disabled='{{submitting}}' bindtap='onAddPlanToCart'>一键加购</button>
    </view>

    <view class='card' wx:if='{{addCartFailedItems.length > 0}}'>
      <view class='card-title'>未加购成功项</view>
      <view class='meta-line' wx:for='{{addCartFailedItems}}' wx:key='index'>
        商品{{item.goodsId}}：{{item.reason}}
      </view>
    </view>
  </view>
</view>
