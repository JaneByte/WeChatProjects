<view class='seasonal-page'>
  <view class='hero'>
    <view class='hero-season'>{{seasonText || '当季'}}</view>
    <view class='hero-title'>{{headline}}</view>
    <view class='hero-sub'>{{subHeadline}}</view>
    <view class='hero-time' wx:if='{{seasonStageText}}'>{{seasonStageText}}</view>
    <view class='hero-time' wx:if='{{refreshText}}'>{{refreshText}}</view>
  </view>

  <view class='filter-wrap'>
    <scroll-view class='filter-scroll' scroll-x show-scrollbar='false'>
      <view class='filter-row'>
        <view
          class='filter-chip {{selectedRegion === item.key ? "active" : ""}}'
          wx:for='{{regionOptions}}'
          wx:key='key'
          data-key='{{item.key}}'
          bindtap='onPickRegion'
        >{{item.text}}</view>
      </view>
    </scroll-view>
    <scroll-view class='filter-scroll' scroll-x show-scrollbar='false'>
      <view class='filter-row'>
        <view
          class='filter-chip {{selectedBudget === item.key ? "active" : ""}}'
          wx:for='{{budgetOptions}}'
          wx:key='key'
          data-key='{{item.key}}'
          bindtap='onPickBudget'
        >{{item.text}}</view>
      </view>
    </scroll-view>
    <scroll-view class='filter-scroll' scroll-x show-scrollbar='false'>
      <view class='filter-row'>
        <view
          class='filter-chip {{selectedProduceType === item.key ? "active" : ""}}'
          wx:for='{{produceOptions}}'
          wx:key='key'
          data-key='{{item.key}}'
          bindtap='onPickProduceType'
        >{{item.text}}</view>
      </view>
    </scroll-view>
    <scroll-view class='filter-scroll' scroll-x show-scrollbar='false'>
      <view class='filter-row'>
        <view
          class='filter-chip {{selectedSort === item.key ? "active" : ""}}'
          wx:for='{{sortOptions}}'
          wx:key='key'
          data-key='{{item.key}}'
          bindtap='onPickSort'
        >{{item.text}}</view>
      </view>
    </scroll-view>
  </view>

  <view class='state' wx:if='{{loading}}'>正在为你整理当季推荐，请稍等</view>
  <view class='state error' wx:elif='{{loadError}}' bindtap='onRetry'>当季推荐暂时没加载出来，点一下重试</view>
  <view class='state' wx:elif='{{items.length === 0}}'>这一档当季商品刚好售空，先看看其他新鲜推荐</view>

  <view class='list' wx:else>
    <view class='fallback-tip' wx:if='{{fallbackUsed && fallbackMessage}}'>{{fallbackMessage}}</view>
    <view class='card' wx:for='{{items}}' wx:key='id' data-id='{{item.id}}' bindtap='onTapItem'>
      <image class='cover' src='{{item.mainImage}}' mode='aspectFill'></image>
      <view class='info'>
        <view class='name-row'>
          <text class='name'>{{item.name}}</text>
          <text class='score'>{{item.totalScore}}</text>
        </view>
        <view class='meta meta-main'>近期销量{{item.salesVolume}}</view>
        <view class='status-row'>
          <text class='status-tag' wx:if='{{item.statusTagText}}'>{{item.statusTagText}}</text>
          <text class='status-tag warn' wx:if='{{item.urgencyText}}'>{{item.urgencyText}}</text>
        </view>
        <view class='reason reason-main'>{{item.listReason}}</view>
        <view class='tag-row' wx:if='{{item.tags && item.tags.length > 0}}'>
          <text class='tag' wx:for='{{item.tags}}' wx:key='index'>{{item}}</text>
        </view>
        <view class='foot'>
          <view class='price-block'>
            <view class='price-row'>
              <text class='price'>¥{{item.price}}</text>
              <text class='origin-price' wx:if='{{item.originalPrice > item.price}}'>¥{{item.originalPrice}}</text>
            </view>
          </view>
          <view
            class='add-btn {{addingId === item.id ? "add-btn--loading" : ""}}'
            catchtap='onAddCart'
            data-id='{{item.id}}'
          >{{addingId === item.id ? '加购中' : '加入购物车'}}</view>
        </view>
      </view>
    </view>
  </view>
</view>
